# 复制为 .env 后替换所有示例敏感值；首次启动 MySQL 时会自动创建下方数据库和应用用户。
# 可分别运行 `openssl rand -hex 24` 生成两个不同的数据库密码；.env 已被 Git/Docker 忽略。
MYSQL_DATABASE=fluffy_cupcake
MYSQL_USER=fluffy_cupcake
MYSQL_PASSWORD=replace_with_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_different_root_password
MYSQL_PORT=3306

# 本地 Go 服务/创建用户 CLI 经宿主机端口访问 MySQL；这里必须复用 MYSQL_PASSWORD。
# 只使用字母数字形式的随机密码时可直接替换；特殊字符需要按 MySQL DSN 规则转义。
DATABASE_DSN='fluffy_cupcake:replace_with_random_database_password@tcp(127.0.0.1:3306)/fluffy_cupcake'

# 可运行 `openssl rand -hex 32` 独立生成；不能复用数据库或登录密码，也不能保留示例值。
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRE=24h
