# 复制为 .env 后替换所有示例敏感值；首次启动 MySQL 时会自动创建下方数据库和应用用户。
# 可分别运行 `openssl rand -hex 24` 生成两个不同的数据库密码；.env 已被 Git/Docker 忽略。
MYSQL_DATABASE=fluffy_cupcake
MYSQL_USER=fluffy_cupcake
MYSQL_PASSWORD=replace_with_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_different_root_password
MYSQL_PORT=3306

# Local：宿主机 Go 服务/CLI → Docker Compose MySQL；这里必须复用 MYSQL_PASSWORD。
# 示例显式配置 5s 网络超时；应用也会为遗漏的 timeout/readTimeout/writeTimeout 自动补相同默认值。
# 特殊字符密码需按 MySQL DSN 规则转义。
DATABASE_DSN='fluffy_cupcake:replace_with_random_database_password@tcp(127.0.0.1:3306)/fluffy_cupcake?timeout=5s&readTimeout=5s&writeTimeout=5s'

# Production：Singapore Sealos App → Guangzhou Managed MySQL External/Public Endpoint。
# 在 Sealos Secret/环境变量中单独设置 DATABASE_DSN，不要把真实值写回本文件；生产账号禁止使用 root。
# 示例：fluffy_cupcake_app:URL_ENCODED_PASSWORD@tcp(GUANGZHOU_PUBLIC_ENDPOINT:3306)/fluffy_cupcake?timeout=5s&readTimeout=5s&writeTimeout=5s
# 证书可验证时追加 tls=true；只有明确接受“不验证服务器身份”的风险时才使用 tls=skip-verify，不能使用会回退明文的 tls=preferred。

DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# 可运行 `openssl rand -hex 32` 独立生成；不能复用数据库或登录密码，也不能保留示例值。
JWT_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_TTL=15m
SESSION_TTL=360h
